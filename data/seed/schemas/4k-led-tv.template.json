{
  "category": "4K LED TV",
  "description": "Hint schema for 4K LED televisions. The schema-discovery agent uses this as few-shot grounding; it is free to add, rename, or drop fields based on evidence from the raw pages.",
  "fields": [
    {"name": "brand",                "dtype": "string",  "required": true,  "examples": ["Samsung", "LG", "Sony", "TCL", "Xiaomi"]},
    {"name": "model_number",         "dtype": "string",  "required": true,  "description": "Manufacturer model identifier",       "examples": ["UA55CU7700KLXL", "43UR7500PSC"]},
    {"name": "series",               "dtype": "string",  "required": false, "examples": ["Crystal 4K", "UR75", "Bravia X75L"]},
    {"name": "screen_size_inches",   "dtype": "float",   "unit": "inch",   "required": true, "min": 20, "max": 120},
    {"name": "resolution",           "dtype": "enum",    "required": true, "enum_values": ["HD", "Full HD", "4K UHD", "8K UHD"]},
    {"name": "resolution_pixels",    "dtype": "string",  "required": true, "examples": ["3840x2160"]},
    {"name": "display_type",         "dtype": "enum",    "required": true, "enum_values": ["LED", "QLED", "OLED", "Mini-LED", "Neo QLED", "Nanocell"]},
    {"name": "panel_type",           "dtype": "enum",    "required": false, "enum_values": ["IPS", "VA", "ADS", "OLED"]},
    {"name": "refresh_rate_hz",      "dtype": "int",     "unit": "Hz",     "required": true, "enum_values": [50, 60, 100, 120, 144]},
    {"name": "hdr_support",          "dtype": "string",  "required": false, "examples": ["HDR10, HLG", "Dolby Vision, HDR10+, HLG"]},
    {"name": "smart_tv",             "dtype": "bool",    "required": true},
    {"name": "operating_system",     "dtype": "enum",    "required": false, "enum_values": ["Tizen", "webOS", "Google TV", "Android TV", "Fire TV", "Roku TV", "VIDAA", "PatchWall"]},
    {"name": "processor",            "dtype": "string",  "required": false, "examples": ["Crystal Processor 4K", "α5 Gen 6 AI Processor 4K"]},
    {"name": "hdmi_ports",           "dtype": "int",     "required": true, "min": 1, "max": 6},
    {"name": "usb_ports",            "dtype": "int",     "required": true, "min": 0, "max": 4},
    {"name": "hdmi_version",         "dtype": "enum",    "required": false, "enum_values": ["1.4", "2.0", "2.1"]},
    {"name": "wifi_standard",        "dtype": "enum",    "required": false, "enum_values": ["WiFi 4 (802.11n)", "WiFi 5 (802.11ac)", "WiFi 6 (802.11ax)", "WiFi 6E"]},
    {"name": "bluetooth_version",    "dtype": "string",  "required": false, "examples": ["5.0", "5.2"]},
    {"name": "ethernet_lan",         "dtype": "bool",    "required": false},
    {"name": "speaker_output_watts", "dtype": "int",     "unit": "W",      "required": true, "min": 5, "max": 200},
    {"name": "speaker_configuration","dtype": "string",  "required": false, "examples": ["2.0 CH", "2.1 CH Down-firing"]},
    {"name": "dolby_audio",          "dtype": "bool",    "required": false},
    {"name": "voice_assistant",      "dtype": "string",  "required": false, "examples": ["Bixby", "Google Assistant", "Alexa"]},
    {"name": "screen_mirroring",     "dtype": "bool",    "required": false},
    {"name": "energy_rating",        "dtype": "string",  "required": false, "examples": ["3 Star", "4 Star", "5 Star"]},
    {"name": "power_consumption_w",  "dtype": "int",     "unit": "W",      "required": false},
    {"name": "weight_kg",            "dtype": "float",   "unit": "kg",     "required": false},
    {"name": "dimensions_mm",        "dtype": "string",  "required": false, "description": "WxHxD without stand"},
    {"name": "warranty_years",       "dtype": "int",     "required": false, "min": 1, "max": 5},
    {"name": "launch_year",          "dtype": "int",     "required": false, "min": 2015, "max": 2030},
    {"name": "mrp_inr",              "dtype": "int",     "unit": "INR",    "required": false},
    {"name": "current_price_inr",    "dtype": "int",     "unit": "INR",    "required": false}
  ]
}
